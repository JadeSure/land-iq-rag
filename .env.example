# ── LandIQ RAG local configuration ──────────────────────────────────────────
# Copy to .env and adjust. All settings are read with the RAG_ prefix.

# Deployment profile: local | aws  (selects port implementations)
RAG_PROFILE=local

# Postgres + pgvector connection (matches docker-compose.yml)
RAG_DATABASE_URL=postgresql://landiq:landiq@localhost:5433/landiq_rag

# Raw-document storage
#   local -> filesystem under RAG_STORAGE_LOCAL_ROOT
#   s3    -> RAG_S3_BUCKET (AWS / Track B)
RAG_STORAGE_BACKEND=local
RAG_STORAGE_LOCAL_ROOT=./storage

# Active embedding model (DB rag_config is authoritative at runtime; this seeds it).
#   hash:feature-256                    -> deterministic, zero-dependency, no API key (DEFAULT)
#   hf:BAAI/bge-small-en-v1.5          -> local HuggingFace, 133 MB, 384-dim, MIT (uv sync --extra hf)
#   hf:BAAI/bge-base-en-v1.5           -> local HuggingFace, 438 MB, 768-dim, higher accuracy
#   openai:text-embedding-3-small       -> requires RAG_OPENAI_API_KEY, 1536-dim, $0.02/1M tok
#   openai:text-embedding-3-large       -> requires RAG_OPENAI_API_KEY, 3072-dim, $0.13/1M tok
#   gemini:gemini-embedding-001         -> requires RAG_GEMINI_API_KEY, 1536-dim, $0.15/1M tok
#   selfhosted:<name>                   -> requires RAG_SELFHOSTED_URL (e.g. HuggingFace TEI)
RAG_ACTIVE_EMBEDDING_MODEL=hash:feature-256

# OpenAI (only needed when the active model is openai:*)
RAG_OPENAI_API_KEY=

# Google Gemini (only needed when the active model is gemini:*)
RAG_GEMINI_API_KEY=

# PDF extraction — fallback cascade
#   When pdfplumber yields sparse text (avg chars/page < threshold * 250),
#   the pipeline tries: 1) pytesseract OCR, 2) Claude API (if key set).
#   Leave RAG_ANTHROPIC_API_KEY blank to disable the Claude fallback.
RAG_ANTHROPIC_API_KEY=
RAG_PDF_FALLBACK_THRESHOLD=0.4

# Chunking (deterministic under fixed values; PRD 8.4)
RAG_CHUNK_TOKENS=600
RAG_CHUNK_OVERLAP=100

# Ingestion worker
RAG_WORKER_ENABLED=true
RAG_WORKER_POLL_SECONDS=1.0
RAG_WORKER_BATCH=2
RAG_INGEST_MAX_ATTEMPTS=5

# Retrieval defaults
RAG_QUERY_DEFAULT_K=8
