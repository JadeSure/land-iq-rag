                <mxCell id="L_rrf" value="③ RRF Fusion  (FULL OUTER JOIN vec ⟕ fts)&#xa;&#xa;score  =  1 / (rank_vec  + 60)&#xa;           +  1 / (rank_bm25 + 60)&#xa;&#xa;ORDER BY score DESC  →  LIMIT k" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#9673a6;strokeColor=#7a4f8a;fontColor=#ffffff;fontSize=11;fontStyle=1;" parent="1" vertex="1">
