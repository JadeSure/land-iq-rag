                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="eF12" value="query vector" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#647687;strokeWidth=2;fontSize=10;" parent="1" source="F_qembed" target="F_vec" edge="1">
