                <mxCell id="eF15" value="fts @@ tsquery" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;dashed=1;strokeColor=#647687;strokeWidth=2;fontSize=10;" parent="1" source="F_bm25" target="F_db" edge="1">
