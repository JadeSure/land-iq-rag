                <mxCell id="L_pg" value="Postgres 16 + pgvector  (Docker · port 5433)&#xa;&#xa;document   ·   chunk  + fts column (generated tsvector · GIN indexed)   ·   embedding_&lt;model&gt;  (HNSW · one table per model)&#xa;embedding_model (registry)   ·   ingest_job (queue + status · SKIP LOCKED)   ·   query_log   ·   rag_config" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#d79b00;strokeColor=#a06c00;fontColor=#ffffff;fontSize=12;fontStyle=1;" parent="1" vertex="1">
