                <mxCell id="B_chunk_1" value="&lt;b style=&quot;color:#bf7d00&quot;&gt;PK&lt;/b&gt; &lt;b&gt;chunk_id&lt;/b&gt;  &lt;span style=&quot;color:#6b7280&quot;&gt;UUID&lt;/span&gt;  &lt;span style=&quot;color:#9aa0a6&quot;&gt;surrogate id&lt;/span&gt;" style="text;html=1;align=left;spacingLeft=10;fontSize=11;" parent="B_chunk" vertex="1">
