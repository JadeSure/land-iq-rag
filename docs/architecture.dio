                <mxCell id="eF8" value="vectors" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#647687;strokeWidth=2;fontSize=10;" parent="1" source="F_embed" target="F_flip" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="eF9" value="write + flip" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#647687;strokeWidth=2;fontSize=10;" parent="1" source="F_flip" target="F_db" edge="1">
