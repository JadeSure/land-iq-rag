                <mxCell id="eF3" value="enqueue" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7a4f8a;strokeWidth=2;fontSize=10;" parent="1" source="F_store" target="F_queue" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
