                    <mxGeometry x="405" y="420" width="130" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="i_skipped" value="record job state = skipped&#xa;return 202 {task_id} (end)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="630" y="425" width="180" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="i_put" value="Storage.put(bytes)&#xa;LocalFsStorage / S3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="370" y="540" width="200" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="i_putok" value="store&#xa;succeeded?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="405" y="620" width="130" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="i_503" value="503 storage&#xa;unavailable (end)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="640" y="635" width="150" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="i_enq" value="upsert document (new doc_version)&#xa;enqueue ingest_job (pending)&#xa;return 202 {task_id}" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="350" y="730" width="240" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="i_claim" value="Worker claims job&#xa;(Postgres SKIP LOCKED / SQS)&#xa;state → extracting" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="350" y="830" width="240" height="60" as="geometry"/>
