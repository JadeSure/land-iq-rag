                    <mxGeometry x="40" y="24" width="900" height="28" as="geometry"/>
                </mxCell>
                <mxCell id="er_sub" value="Core data chain runs down the centre (address → document → chunk → vector). Operational tables sit on the sides. Each row shows  key · name · type · meaning." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;" parent="1" vertex="1">
                    <mxGeometry x="40" y="52" width="1100" height="22" as="geometry"/>
