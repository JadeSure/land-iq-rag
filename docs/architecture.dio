                <mxCell id="eF4" value="claim job (SKIP LOCKED / SQS)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#d79b00;strokeWidth=2;fontSize=10;" parent="1" source="F_queue" target="F_worker" edge="1">
