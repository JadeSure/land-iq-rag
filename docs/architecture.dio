                <mxCell id="eF19" value="ranked chunks + score" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;dashed=1;strokeColor=#6c8ebf;strokeWidth=2;fontSize=10;" parent="1" source="F_results" target="F_agent" edge="1">
                    <mxGeometry relative="1" as="geometry">
