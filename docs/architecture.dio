                <mxCell id="eF16" value="rank ①" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#9673a6;strokeWidth=2;fontSize=10;" parent="1" source="F_vec" target="F_rrf" edge="1">
