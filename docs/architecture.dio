                <mxCell id="B_chunk_3" value="&lt;b style=&quot;color:#2d6fb3&quot;&gt;FK&lt;/b&gt; &lt;b&gt;address_id&lt;/b&gt;  &lt;span style=&quot;color:#6b7280&quot;&gt;TEXT&lt;/span&gt;  &lt;span style=&quot;color:#9aa0a6&quot;&gt;denormalised owner; powers the address filter&lt;/span&gt;" style="text;html=1;align=left;spacingLeft=10;fontSize=11;" parent="B_chunk" vertex="1">
