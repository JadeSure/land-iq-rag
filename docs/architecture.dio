                <mxCell id="eF13" value="query text" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#647687;strokeWidth=2;fontSize=10;" parent="1" source="F_qembed" target="F_bm25" edge="1">
