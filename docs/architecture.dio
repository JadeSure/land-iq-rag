                    <mxGeometry y="92" width="470" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="B_chunk_5" value="&lt;b&gt;ordinal&lt;/b&gt;  &lt;span style=&quot;color:#6b7280&quot;&gt;INT&lt;/span&gt;  &lt;span style=&quot;color:#9aa0a6&quot;&gt;position in doc; UNIQUE(doc_id, doc_version, ordinal)&lt;/span&gt;" style="text;html=1;align=left;spacingLeft=10;fontSize=11;" parent="B_chunk" vertex="1">
