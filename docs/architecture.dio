                <mxCell id="B_job_21" value="&lt;b&gt;lease_until&lt;/b&gt;  &lt;span style=&quot;color:#6b7280&quot;&gt;TIMESTAMPTZ&lt;/span&gt;  &lt;span style=&quot;color:#9aa0a6&quot;&gt;SKIP LOCKED lease expiry&lt;/span&gt;" style="text;html=1;align=left;spacingLeft=10;fontSize=11;" parent="B_job" vertex="1">
                    <mxGeometry y="466" width="560" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="B_job_22" value="&lt;b&gt;created_at&lt;/b&gt;  &lt;span style=&quot;color:#6b7280&quot;&gt;TIMESTAMPTZ&lt;/span&gt;  &lt;span style=&quot;color:#9aa0a6&quot;&gt;enqueued&lt;/span&gt;" style="text;html=1;align=left;spacingLeft=10;fontSize=11;" parent="B_job" vertex="1">
                    <mxGeometry y="488" width="560" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="B_job_23" value="&lt;b&gt;finished_at&lt;/b&gt;  &lt;span style=&quot;color:#6b7280&quot;&gt;TIMESTAMPTZ&lt;/span&gt;  &lt;span style=&quot;color:#9aa0a6&quot;&gt;completed / failed time&lt;/span&gt;" style="text;html=1;align=left;spacingLeft=10;fontSize=11;" parent="B_job" vertex="1">
                    <mxGeometry y="510" width="560" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="e_ad" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=ERmany;startArrow=ERone;strokeColor=#333333;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" parent="1" source="B_addr" target="B_doc" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_dc" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=ERmany;startArrow=ERone;strokeColor=#333333;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" parent="1" source="B_doc" target="B_chunk" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_ce" value="1 : 1  per model table" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=ERone;startArrow=ERone;strokeColor=#b85450;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" parent="1" source="B_chunk" target="B_emb" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_ac" value="FK · denormalised" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=ERmany;startArrow=ERone;strokeColor=#2d6fb3;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" parent="1" source="B_addr" target="B_chunk" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="560" y="136"/>
                            <mxPoint x="560" y="705"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="e_dj" value="1 : N · FK (nullable)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=ERmany;startArrow=ERone;strokeColor=#d79b00;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;entryX=0;entryY=0.08;" parent="1" source="B_doc" target="B_job" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_re" value="registers (table_name)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;dashed=1;strokeColor=#9673a6;strokeWidth=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" parent="1" source="B_reg" target="B_emb" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="555" y="597"/>
                            <mxPoint x="555" y="988"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="e_cr" value="active_embedding_model" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;dashed=1;strokeColor=#9aa0a6;strokeWidth=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" parent="1" source="B_cfg" target="B_reg" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="20" y="136"/>
                            <mxPoint x="20" y="597"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="e_qa" value="soft ref (no FK)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;dashed=1;strokeColor=#9aa0a6;strokeWidth=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.15;entryX=0;entryY=0.75;" parent="1" source="B_qlog" target="B_addr" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="560" y="265"/>
                            <mxPoint x="560" y="158"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="N_legend" value="Legend&#xa;──────────────────────────────&#xa;PK  primary key      FK  foreign key      PK·FK  both&#xa;Solid line + crow&#39;s foot  =  enforced FK (ON DELETE CASCADE)&#xa;Dashed grey line  =  soft reference (by value, no FK constraint)&#xa;grey italic text  =  plain-language meaning of the column&#xa;──────────────────────────────&#xa;amber   root entity (address)&#xa;blue    document&#xa;green   chunk (text + FTS)&#xa;pink    vector (embedding_{model}, dynamic)&#xa;orange  ingest_job (queue + status)&#xa;purple  embedding_model (registry)&#xa;grey    rag_config (runtime config)&#xa;teal    query_log (observability)" style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;spacingLeft=8;spacingTop=6;fillColor=#fbfbfb;strokeColor=#cccccc;fontColor=#333333;" parent="1" vertex="1">
                    <mxGeometry x="1800" y="90" width="440" height="300" as="geometry"/>
                </mxCell>
                <mxCell id="N_iso" value="Address isolation — correctness red line&#xa;──────────────────────────────&#xa;chunk and every embedding table mix ALL addresses in one&#xa;physical table. Every read MUST carry&#xa;    WHERE address_id = :addr&#xa;hard-coded in store/embeddings.py::hybrid_search.&#xa;Omitting it = cross-address leak = correctness defect." style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;spacingLeft=8;spacingTop=6;fillColor=#fdecea;strokeColor=#b85450;fontColor=#7a2e2b;" parent="1" vertex="1">
                    <mxGeometry x="1800" y="410" width="440" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="N_ver" value="Atomic version switch (re-ingest)&#xa;──────────────────────────────&#xa;A new upload writes a fresh doc_version beside the old one&#xa;(UNIQUE doc_id, doc_version, ordinal). One transaction flips&#xa;document.live_version and drops the old rows. Queries read&#xa;only doc_version = live_version, so a reader sees all-old or&#xa;all-new content, never a half-built state." style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;spacingLeft=8;spacingTop=6;fillColor=#e8f5e9;strokeColor=#82b366;fontColor=#1a3d1a;" parent="1" vertex="1">
                    <mxGeometry x="1800" y="600" width="440" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="N_dyn" value="One table per model (F14, dynamic)&#xa;──────────────────────────────&#xa;embedding_{model} is created at runtime by&#xa;store/db.py::ensure_embedding_table — one table per model,&#xa;with a fixed-dimension vector column. Each chunk gets one&#xa;row in EVERY model table that has been built. Only the model&#xa;named in rag_config.active_embedding_model is queried; the&#xa;rest sit idle until you switch. &#39;Never mix models in a&#xa;ranking&#39; is therefore structural, not a runtime filter." style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;spacingLeft=8;spacingTop=6;fillColor=#fff0f0;strokeColor=#b85450;fontColor=#7a2e2b;" parent="1" vertex="1">
                    <mxGeometry x="1800" y="790" width="440" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="N_state" value="ingest_job.state — ingest_state ENUM&#xa;──────────────────────────────&#xa;pending → extracting → chunking → embedding → done&#xa;                           ↘ skipped (content_hash unchanged)&#xa;On error: attempts &lt; max_attempts ⇒ back to pending; else failed.&#xa;Local queue: rows claimed via SELECT … FOR UPDATE SKIP LOCKED." style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;spacingLeft=8;spacingTop=6;fillColor=#fff8e6;strokeColor=#d79b00;fontColor=#a06c00;" parent="1" vertex="1">
                    <mxGeometry x="1180" y="800" width="560" height="120" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram name="End-to-End Flow" id="page-flow">
        <mxGraphModel dx="961" dy="418" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="F_title" value="LandIQ RAG — End-to-End Flow (upload → store → embed → query)" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#232F3E;" parent="1" vertex="1">
                    <mxGeometry x="40" y="20" width="900" height="28" as="geometry"/>
                </mxCell>
                <mxCell id="F_sub" value="Profile-agnostic logical flow. Storage = LocalFsStorage (local) / S3 (AWS); queue = Postgres SKIP LOCKED (local) / SQS (AWS). The pipeline body is identical on both." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;" parent="1" vertex="1">
                    <mxGeometry x="40" y="50" width="1100" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="F_lane_ingest" value="INGEST" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#a06c00;rotation=-90;" parent="1" vertex="1">
                    <mxGeometry x="8" y="280" width="60" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="F_lane_query" value="QUERY" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#314354;rotation=-90;" parent="1" vertex="1">
                    <mxGeometry x="8" y="700" width="60" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="F_divider" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#CCCCCC;strokeWidth=2;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="40" y="588" as="sourcePoint"/>
                        <mxPoint x="1360" y="588" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="F_user" value="① User / Portal&#xa;uploads a PDF&#xa;POST /addresses/{id}/documents" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6c8ebf;strokeColor=#3a5b8c;fontColor=#ffffff;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="60" y="100" width="200" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="F_api_in" value="② API (FastAPI / Lambda)&#xa;• sha256(bytes)&#xa;• same content_hash? → skipped&#xa;• else store + enqueue → 202 {task_id}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#82b366;strokeColor=#4d7a31;fontColor=#ffffff;fontSize=11;fontStyle=1;align=left;spacingLeft=8;" parent="1" vertex="1">
                    <mxGeometry x="320" y="95" width="270" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="F_store" value="③ Storage.put(bytes)&#xa;LocalFsStorage / S3&#xa;raw PDF" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#d6b656;strokeColor=#a68a2e;fontColor=#ffffff;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="650" y="90" width="150" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="F_queue" value="④ insert document + ingest_job (pending)&#xa;enqueue: Postgres SKIP LOCKED / SQS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#9673a6;strokeColor=#7a4f8a;fontColor=#ffffff;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="870" y="95" width="300" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="F_worker" value="⑤ Ingest worker  (asyncio.Task / SQS Lambda)&#xa;claims job · drives the state machine&#xa;&#xa;pending → extracting → chunking → embedding → done&#xa;                                    ↘ skipped (hash unchanged)&#xa;                                    ↘ failed   (after max_attempts)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d79b00;strokeColor=#a06c00;fontColor=#ffffff;fontSize=11;fontStyle=1;align=left;spacingLeft=8;" parent="1" vertex="1">
                    <mxGeometry x="60" y="230" width="430" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="F_extract" value="extract&#xa;pdfplumber → OCR (pytesseract)&#xa;→ Claude Haiku 4.5 (last resort)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8a33d;strokeColor=#a06c00;fontColor=#ffffff;fontSize=10;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="540" y="220" width="200" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="F_chunk" value="chunk&#xa;token-aware · tiktoken" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8a33d;strokeColor=#a06c00;fontColor=#ffffff;fontSize=10;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="540" y="300" width="200" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="F_embed" value="⑥ EmbeddingProvider.embed(chunks)&#xa;hash:feature-256 (default · offline)&#xa;hf:BAAI/bge-* · openai:text-embedding-3-*" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b85450;strokeColor=#843b38;fontColor=#ffffff;fontSize=10;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="790" y="220" width="280" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="F_flip" value="⑦ write chunks + embeddings at NEW doc_version&#xa;then atomically flip live_version&#xa;(reader sees all-old or all-new — never half)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#647687;strokeColor=#314354;fontColor=#ffffff;fontSize=10;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="790" y="310" width="280" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="F_db" value="Postgres + pgvector&#xa;document · chunk (+fts GIN) · embedding_{model} (HNSW, one table per model) · ingest_job · query_log · rag_config" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#d79b00;strokeColor=#a06c00;fontColor=#ffffff;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="60" y="430" width="1300" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="F_agent" value="⑧ Agent / consumer&#xa;asks a question&#xa;POST /addresses/{id}/query" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6c8ebf;strokeColor=#3a5b8c;fontColor=#ffffff;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="60" y="630" width="200" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="F_qembed" value="⑨ embed query&#xa;same active EmbeddingProvider" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b85450;strokeColor=#843b38;fontColor=#ffffff;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="320" y="635" width="220" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="F_iso" value="⚑ mandatory  WHERE address_id = ?   (cross-address leakage = correctness defect)" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#b85450;fontStyle=3;" parent="1" vertex="1">
                    <mxGeometry x="600" y="610" width="500" height="18" as="geometry"/>
                </mxCell>
                <mxCell id="F_vec" value="① Vector ANN&#xa;pgvector HNSW · cosine&#xa;top k×4 by distance" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#647687;strokeColor=#314354;fontColor=#ffffff;fontSize=10;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="600" y="635" width="200" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="F_bm25" value="② BM25 full-text&#xa;tsvector GIN · ts_rank_cd&#xa;top k×4 by term freq" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#647687;strokeColor=#314354;fontColor=#ffffff;fontSize=10;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="830" y="635" width="200" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="F_rrf" value="③ RRF fusion&#xa;score = 1/(rank_vec+60) + 1/(rank_bm25+60)&#xa;ORDER BY score DESC → LIMIT k" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#9673a6;strokeColor=#7a4f8a;fontColor=#ffffff;fontSize=10;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="700" y="740" width="330" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="F_results" value="⑩ top-k chunks · score · provenance (text · page · ordinal · doc) → back to Agent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#82b366;strokeColor=#4d7a31;fontColor=#ffffff;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="1080" y="745" width="280" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="eF1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;strokeWidth=2;" parent="1" source="F_user" target="F_api_in" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="eF2" value="put bytes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#a68a2e;strokeWidth=2;fontSize=10;" parent="1" source="F_api_in" target="F_store" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
