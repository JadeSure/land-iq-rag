                <mxCell id="L_fs" value="Local Filesystem&#xa;raw PDFs&#xa;LocalFsStorage" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#d6b656;strokeColor=#a68a2e;fontColor=#ffffff;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="70" y="252" width="150" height="98" as="geometry"/>
                </mxCell>
                <mxCell id="L_worker" value="Worker  (asyncio.Task · same process)&#xa;① extract — PDF/image read cascade (I2):&#xa;  a · pdfplumber (text + real tables)&#xa;  b · OCR pytesseract + pdf2image (if sparse)&#xa;  c · Anthropic Claude Haiku 4.5 (last resort)&#xa;② chunk     token-aware · tiktoken&#xa;③ embed     via EmbeddingProvider&#xa;④ write      chunks + embeddings at new doc_version&#xa;⑤ flip        live_version (atomic · no partial reads)&#xa;⎯⎯ rebuild ⎯⎯&#xa;backfill missing → sweep stragglers&#xa;→ flip active model pointer (global only)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d79b00;strokeColor=#a06c00;fontColor=#ffffff;fontSize=11;fontStyle=1;align=left;spacingLeft=8;" parent="1" vertex="1">
                    <mxGeometry x="240" y="244" width="334" height="254" as="geometry"/>
                </mxCell>
                <mxCell id="L_embed" value="EmbeddingProvider  (pluggable · RAG_ACTIVE_EMBEDDING_MODEL)&#xa;hash:feature-256     default · fully offline · no API key  ◀ current&#xa;hf:BAAI/bge-*          local HuggingFace · no egress&#xa;openai:text-embedding-3-*   optional · requires RAG_OPENAI_API_KEY" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b85450;strokeColor=#843b38;fontColor=#ffffff;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="70" y="508" width="470" height="82" as="geometry"/>
                </mxCell>
                <mxCell id="L_vec" value="① Vector ANN&#xa;pgvector · HNSW index&#xa;cosine distance&#xa;embed query → same EmbeddingProvider&#xa;top k×4 candidates by distance" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#647687;strokeColor=#314354;fontColor=#ffffff;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="608" y="252" width="210" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="L_bm25" value="② BM25 Full-text&#xa;tsvector · GIN index&#xa;ts_rank_cd · plainto_tsquery&#xa;keyword match on raw text&#xa;top k×4 by term frequency" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#647687;strokeColor=#314354;fontColor=#ffffff;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="860" y="252" width="210" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="L_iso" value="⚑  mandatory: WHERE address_id = ?   (cross-address leakage = correctness defect)" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#b85450;fontStyle=3;" parent="1" vertex="1">
                    <mxGeometry x="600" y="370" width="480" height="18" as="geometry"/>
                </mxCell>
                <mxCell id="L_rrf" value="③ RRF Fusion  (FULL OUTER JOIN vec ⟕ fts)&#xa;&#xa;score  =  1 / (rank_vec  + 60)&#xa;           +  1 / (rank_bm25 + 60)&#xa;&#xa;ORDER BY score DESC  →  LIMIT k" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#9673a6;strokeColor=#7a4f8a;fontColor=#ffffff;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="672" y="398" width="340" height="110" as="geometry"/>
