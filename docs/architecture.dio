                <mxCell id="eF6" value="segments" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#a06c00;strokeWidth=2;fontSize=10;" parent="1" source="F_extract" target="F_chunk" edge="1">
