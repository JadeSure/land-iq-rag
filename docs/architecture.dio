                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="eq9" value="rank list ①" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#9673a6;strokeWidth=2;fontSize=10;" parent="1" source="q_ann" target="q_rrf" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="eq10" value="rank list ②" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#9673a6;strokeWidth=2;fontSize=10;" parent="1" source="q_bm25" target="q_rrf" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="eq11" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#333;strokeWidth=2;" parent="1" source="q_rrf" target="q_log" edge="1">
