    <diagram name="Flowchart — Query" id="page-fc-query">
        <mxGraphModel dx="961" dy="549" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1200" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="tq_title" value="Query Flowchart — embed query → ANN + BM25 → RRF fusion → top-k" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;fontColor=#232F3E;" parent="1" vertex="1">
                    <mxGeometry x="40" y="16" width="1000" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="q_start" value="Start&#xa;agent asks a question" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="380" y="60" width="200" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="q_post" value="POST /addresses/{id}/query&#xa;resolve active model from rag_config" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="360" y="150" width="240" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="q_table" value="model table&#xa;exists?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="415" y="230" width="130" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="q_empty" value="return empty results&#xa;(log query) → end" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="640" y="245" width="180" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="q_embed" value="embed query&#xa;(same active EmbeddingProvider)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="360" y="340" width="240" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="q_iso" value="apply mandatory  WHERE address_id = ?&#xa;(isolation chokepoint)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#7a2e2b;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="360" y="420" width="240" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="q_split" value="hybrid_search" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="420" y="500" width="120" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="q_ann" value="Vector ANN&#xa;pgvector HNSW · cosine&#xa;embedding &lt;=&gt; query_vec&#xa;top k×4 by distance" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#647687;strokeColor=#314354;fontColor=#fff;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="200" y="610" width="220" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="q_bm25" value="BM25 full-text&#xa;tsvector GIN · ts_rank_cd&#xa;fts @@ plainto_tsquery&#xa;top k×4 by term freq" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#647687;strokeColor=#314354;fontColor=#fff;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="540" y="610" width="220" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="q_rrf" value="RRF fusion (FULL OUTER JOIN)&#xa;score = 1/(rank_vec+60) + 1/(rank_bm25+60)&#xa;ORDER BY score DESC → LIMIT k" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="320" y="730" width="320" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="q_log" value="log latency · candidates · returned · cost&#xa;(query_log)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="350" y="820" width="260" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="q_end" value="return top-k chunks&#xa;score · provenance (text · page · doc)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="350" y="910" width="260" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="eq1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#333;strokeWidth=2;" parent="1" source="q_start" target="q_post" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="eq2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#333;strokeWidth=2;" parent="1" source="q_post" target="q_table" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="eq3" value="no" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#d6b656;strokeWidth=2;fontSize=10;" parent="1" source="q_table" target="q_empty" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="eq4" value="yes" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#82b366;strokeWidth=2;fontSize=10;" parent="1" source="q_table" target="q_embed" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="eq5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#333;strokeWidth=2;" parent="1" source="q_embed" target="q_iso" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
