    <diagram name="Flowchart — Ingest" id="page-fc-ingest">
        <mxGraphModel dx="1131" dy="646" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1700" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="ti_title" value="Ingest Flowchart — upload → store → extract → chunk → embed → flip live_version" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;fontColor=#232F3E;" parent="1" vertex="1">
                    <mxGeometry x="40" y="16" width="1000" height="26" as="geometry"/>
