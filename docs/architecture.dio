                <mxCell id="L_worker" value="Worker  (asyncio.Task · same process)&#xa;① extract — PDF/image read cascade (I2):&#xa;  a · pdfplumber (text + real tables)&#xa;  b · OCR pytesseract + pdf2image (if sparse)&#xa;  c · Anthropic Claude Haiku 4.5 (last resort)&#xa;② chunk     token-aware · tiktoken&#xa;③ embed     via EmbeddingProvider&#xa;④ write      chunks + embeddings at new doc_version&#xa;⑤ flip        live_version (atomic · no partial reads)&#xa;⎯⎯ rebuild ⎯⎯&#xa;backfill missing → sweep stragglers&#xa;→ flip active model pointer (global only)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d79b00;strokeColor=#a06c00;fontColor=#ffffff;fontSize=11;fontStyle=1;align=left;spacingLeft=8;" parent="1" vertex="1">
                    <mxGeometry x="240" y="244" width="334" height="254" as="geometry"/>
                </mxCell>
                <mxCell id="L_embed" value="EmbeddingProvider  (pluggable · RAG_ACTIVE_EMBEDDING_MODEL)&#xa;hash:feature-256     default · fully offline · no API key  ◀ current&#xa;hf:BAAI/bge-*          local HuggingFace · no egress&#xa;openai:text-embedding-3-*   optional · requires RAG_OPENAI_API_KEY" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b85450;strokeColor=#843b38;fontColor=#ffffff;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="70" y="508" width="470" height="82" as="geometry"/>
                </mxCell>
