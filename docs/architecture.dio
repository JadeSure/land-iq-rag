                </mxCell>
                <mxCell id="SM" value="Secrets Manager&#xa;(OpenAI key · DB password)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=#F54749;gradientDirection=north;fillColor=#C7131F;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.secrets_manager;" vertex="1" parent="1">
                    <mxGeometry x="710" y="1170" width="72" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="A11" value="CloudWatch&#xa;(logs, cost metrics)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=#F34482;gradientDirection=north;fillColor=#BC1356;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch;" parent="1" vertex="1">
                    <mxGeometry x="950" y="1170" width="72" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="ANET" value="Internet → OpenAI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#7a2e2b;fontSize=12;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="1470" y="650" width="160" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="Anote" value="AWS (Track B). API is split per route: one plain&#xa;Lambda(event, context) per endpoint behind API&#xa;Gateway (no FastAPI/Mangum). Ingest worker is&#xa;SQS-triggered. Query = hybrid ANN + BM25 → RRF.&#xa;&#xa;Per-Lambda least privilege:&#xa;• query  → DB read · OpenAI · OpenAI key (secret)&#xa;• upload → S3 write · SQS send · DB write&#xa;• status → DB read&#xa;• delete → DB write (+ S3 delete)&#xa;• config → DB / Parameter Store read-write&#xa;• rebuild → SQS send · DB&#xa;All handlers reach the DB via pgbouncer:6432, read&#xa;config from Parameter Store, and log to CloudWatch.&#xa;&#xa;Egress (OpenAI · SQS send · SSM · CloudWatch) goes&#xa;via the NAT instance → IGW; only S3 uses the free&#xa;gateway endpoint. Worker reads PDFs from S3 and&#xa;extracts: pdfplumber → OCR (pytesseract) → Claude.&#xa;Backups: nightly pg_dump → S3 + daily EBS snapshots." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#555555;fontStyle=0;whiteSpace=wrap;" parent="1" vertex="1">
                    <mxGeometry x="1050" y="60" width="350" height="400" as="geometry"/>
                </mxCell>
